#python-code

import numpy as np
import matplotlib.pyplot as plt

# =======================
# ⏱️ TIME
# =======================
t = np.linspace(0, 10, 2000)
dt = t[1] - t[0]

# =======================
# ⚡ GRID SIGNAL
# =======================
base_freq = 50
fluctuation = 2 * np.sin(0.5 * t)
grid_signal = np.sin(2 * np.pi * (base_freq + fluctuation) * t)

# =======================
# 🌪️ NOISE
# =======================
noise = 1.0 * np.random.randn(len(t))
noisy_signal = grid_signal + noise

# =======================
# ⚙️ DTC PARAMETERS
# =======================
N = 60
theta = np.pi * 0.92
J = np.random.uniform(0.8, 1.2, N)

# 🔥 NEW: input coupling strength
k = 0.3

# 🔁 Initialize spins
spins = np.random.uniform(-1, 1, N)
output = np.zeros(len(t))

# =======================
# 🔁 DTC EVOLUTION (FIXED)
# =======================
for i in range(len(t)):

    # 🧠 Inject input signal (CRITICAL FIX)
    spins += k * noisy_signal[i]

    # ⚡ External periodic drive
    spins = spins * np.cos(theta) + np.sin(theta)

    # 🔗 Neighbor interaction (vectorized)
    interaction = np.roll(spins, 1) + np.roll(spins, -1)

    # 🌪️ Nonlinear stabilization
    spins = np.tanh(J * interaction) * spins

    # 🧊 Damping (prevents explosion)
    spins *= 0.98

    # 📤 Output
    output[i] = np.mean(spins)

# =======================
# 📏 NORMALIZATION
# =======================
output = output / np.max(np.abs(output))

# =======================
# 📊 METRICS
# =======================
input_power = noisy_signal**2
output_power = output**2

input_power_var = np.var(input_power)
output_power_var = np.var(output_power)

stability_index = np.std(output)

noise_power = np.mean((noisy_signal - output)**2)
signal_power = np.mean(output**2)
snr = 10 * np.log10(signal_power / noise_power)

# =======================
# 🟢 STATUS
# =======================
status = "🟢 GRID STABLE" if stability_index < 0.2 else "🔴 GRID UNSTABLE"

# =======================
# 📟 DASHBOARD
# =======================
print("\n========== SMART GRID DASHBOARD ==========")
print(f"Input Power Variance   : {input_power_var:.3f}")
print(f"Output Power Variance  : {output_power_var:.3f}")
print(f"Stability Index        : {stability_index:.3f}")
print(f"SNR (dB)               : {snr:.2f}")
print(f"System Status          : {status}")
print("==========================================\n")

# =======================
# 📊 PLOTS
# =======================
plt.figure(figsize=(14,10))

# 1️⃣ Time Domain
plt.subplot(3,2,1)
plt.plot(t, noisy_signal, alpha=0.5, label="Before")
plt.plot(t, output, label="After")
plt.title("Time Domain")
plt.legend()

# 2️⃣ Power Stability
plt.subplot(3,2,2)
plt.plot(t, input_power, alpha=0.5, label="Before")
plt.plot(t, output_power, label="After")
plt.title("Power Stability")
plt.legend()

# 3️⃣ Scatter BEFORE
plt.subplot(3,2,3)
plt.scatter(noisy_signal[:-1], noisy_signal[1:], s=2)
plt.title("Scatter Before")

# 4️⃣ Scatter AFTER
plt.subplot(3,2,4)
plt.scatter(output[:-1], output[1:], s=2)
plt.title("Scatter After")

# 5️⃣ Error Plot
plt.subplot(3,2,5)
error = np.abs(noisy_signal - output)
plt.plot(t, error)
plt.title("Error")

# 6️⃣ FFT
fft_input = np.abs(np.fft.fft(noisy_signal))
fft_output = np.abs(np.fft.fft(output))
freqs = np.fft.fftfreq(len(t), d=dt)

plt.subplot(3,2,6)
plt.plot(freqs[:1000], fft_input[:1000], alpha=0.5, label="Before")
plt.plot(freqs[:1000], fft_output[:1000], label="After")
plt.title("FFT")
plt.legend()

plt.tight_layout()
plt.show()
